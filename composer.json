{
	"name": "towardstudio/craft-cms-guide",
	"description": "A CMS guide for content editors, built into the Craft control panel",
	"type": "craft-plugin",
	"license": "MIT",
	"authors": [
		{
			"name": "Toward",
			"homepage": "https://toward.studio"
		}
	],
	"require": {
		"php": ">=8.2",
		"craftcms/cms": "^5.0.0"
	},
	"bin": [
		"bin/cms-guide-images"
	],
	"autoload": {
		"psr-4": {
			"towardstudio\\cmsguide\\": "src/"
		}
	},
	"extra": {
		"name": "CMS Guide",
		"handle": "cms-guide",
		"developer": "Toward",
		"developerUrl": "https://toward.studio",
		"class": "towardstudio\\cmsguide\\CmsGuide"
	}
}
