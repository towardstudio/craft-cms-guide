{% extends 'cms-guide/_layout' %}

{% block guide %}
	{% include 'cms-guide/_draft' %}
	{{ guide.render(page.body, page.source)|raw }}

	{% if page.siteNotes is defined and page.siteNotes.body|trim %}
		<h2>Specific to {{ siteName }}</h2>
		{% include 'cms-guide/_draft' with { page: page.siteNotes } %}
		{{ guide.render(page.siteNotes.body)|raw }}
	{% endif %}
{% endblock %}
